---
type Props = { data: Record<string, unknown> | Array<Record<string, unknown>> };

// Escapa "<" para que el contenido no pueda cerrar la etiqueta <script>.
const json = JSON.stringify(Astro.props.data).replace(/</g, "\\u003c");
---

<script is:inline type="application/ld+json" set:html={json} />
