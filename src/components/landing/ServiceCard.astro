---
import ServiceIcon from "@/components/landing/ServiceIcon.astro";

import type { Service } from "@/data/services";

/** Tarjeta gris de especialidad, como la de la referencia: icono, título y frase. */
type Props = { service: Service; class?: string };

const { service, class: className } = Astro.props;
---

<article
  class:list={[
    "card-gray group relative flex h-full min-h-[18rem] flex-col p-4 transition-shadow hover:shadow-[var(--shadow-soft)] sm:min-h-[20.5rem]",
    className,
  ]}
>
  <span class="icon-chip">
    <ServiceIcon icon={service.icon} class="size-5" />
  </span>
  <div class="mt-auto pt-10">
    <h3 class="text-lg font-bold text-ink">
      <a
        href={`/especialidades/${service.slug}`}
        class="no-underline after:absolute after:inset-0 after:rounded-[1.25rem] after:content-[''] group-hover:underline"
      >
        {service.title}
      </a>
    </h3>
    <p class="mt-2 text-[0.9375rem] leading-snug text-[#333]">{service.summary}</p>
  </div>
</article>
