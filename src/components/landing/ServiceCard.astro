---
import { ArrowUpRight } from "lucide-react";

import ServiceIcon from "@/components/landing/ServiceIcon.astro";
import { CATEGORIES } from "@/data/services";

import type { Service } from "@/data/services";

/** Tarjeta de especialidad: toda la tarjeta es el enlace. */
type Props = { service: Service; class?: string };

const { service, class: className } = Astro.props;
---

<article
  class:list={[
    "card-soft group relative flex h-full flex-col p-6 transition-shadow hover:shadow-[var(--shadow-soft)]",
    className,
  ]}
>
  <div class="flex items-start justify-between gap-4">
    <span class="grid size-14 place-items-center rounded-2xl bg-white text-brand-600">
      <ServiceIcon icon={service.icon} class="size-7" />
    </span>
    <span class="rounded-full border border-ink/15 bg-white/70 px-3 py-0.5 text-sm font-bold text-ink-muted">
      {CATEGORIES[service.category].title}
    </span>
  </div>
  <h3 class="mt-8 font-display text-2xl font-normal">
    <a
      href={`/especialidades/${service.slug}`}
      class="no-underline after:absolute after:inset-0 after:rounded-[var(--radius-card)] after:content-['']"
    >
      {service.title}
    </a>
  </h3>
  <p class="mt-2 text-ink-muted">{service.summary}</p>
  <span aria-hidden="true" class="mt-auto inline-flex items-center gap-2 pt-6 font-bold">
    <span class="grid size-10 place-items-center rounded-full border border-ink/25 bg-white transition-colors group-hover:bg-ink group-hover:text-white">
      <ArrowUpRight className="size-5" />
    </span>
    Conocer más
  </span>
</article>
