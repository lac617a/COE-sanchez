---
import { Image } from "astro:assets";
import { Redo2, Undo2 } from "lucide-react";

import type { ImageMetadata } from "astro";

/**
 * Carrusel de la portada, como el de la referencia: un círculo de línea fina, una foto
 * con forma de arco y dos flechas blancas sobre el círculo. Sin JavaScript se ve la primera.
 */
type Slide = { src: ImageMetadata; alt: string; fit?: "cover" | "contain" };
type Props = { slides: Slide[] };

const { slides } = Astro.props;
---

<div
  class="relative mx-auto aspect-square w-full max-w-[26rem] md:max-w-[30rem]"
  data-hero-carousel
>
  <!-- Círculo de línea fina -->
  <div aria-hidden="true" class="absolute inset-0 rounded-full border border-white/70"></div>

  <!-- Fotos con forma de arco (esquinas de 54 px arriba y redondas abajo) -->
  <div class="absolute inset-x-[18%] top-[14%] bottom-[-6%] overflow-hidden rounded-t-[3.4rem] rounded-b-[25rem] bg-white shadow-[0_30px_60px_-25px_rgb(0_0_0/0.8)]">
    {slides.map((slide, index) => (
      <Image
        src={slide.src}
        alt={slide.alt}
        widths={[360, 600, 800]}
        sizes="(min-width: 768px) 22rem, 70vw"
        loading={index === 0 ? "eager" : "lazy"}
        data-slide={index}
        aria-hidden={index === 0 ? undefined : "true"}
        class:list={[
          "absolute inset-0 h-full w-full transition-opacity duration-500",
          slide.fit === "contain" ? "object-contain p-8" : "object-cover",
          index === 0 ? "opacity-100" : "opacity-0",
        ]}
      />
    ))}
  </div>

  {slides.length > 1 && (
    <>
      <button
        type="button"
        data-dir="-1"
        class="absolute top-[22%] left-[6%] grid size-11 place-items-center rounded-full bg-white text-ink shadow-md transition-transform hover:scale-105"
      >
        <Undo2 aria-hidden="true" className="size-4" />
        <span class="sr-only">Foto anterior</span>
      </button>
      <button
        type="button"
        data-dir="1"
        class="absolute top-[22%] right-[6%] grid size-11 place-items-center rounded-full bg-white text-ink shadow-md transition-transform hover:scale-105"
      >
        <Redo2 aria-hidden="true" className="size-4" />
        <span class="sr-only">Foto siguiente</span>
      </button>
    </>
  )}
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-hero-carousel]")) {
    const slides = [...root.querySelectorAll<HTMLElement>("[data-slide]")];
    let current = 0;
    const show = (next: number) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        const active = index === current;
        slide.classList.toggle("opacity-100", active);
        slide.classList.toggle("opacity-0", !active);
        if (active) slide.removeAttribute("aria-hidden");
        else slide.setAttribute("aria-hidden", "true");
      });
    };
    root.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((button) => {
      button.addEventListener("click", () => show(current + Number(button.dataset.dir)));
    });
  }
</script>
