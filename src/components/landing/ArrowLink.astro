---
import { ArrowUpRight } from "lucide-react";

/** Botón píldora con la flecha ↗ en un círculo, como en la referencia. */
type Props = {
  href: string;
  tone?: "dark" | "light";
  class?: string;
  external?: boolean;
};

const { href, tone = "dark", class: className, external = false } = Astro.props;
---

<a
  href={href}
  class:list={[
    "btn-arrow",
    tone === "light" ? "text-white hover:bg-white/10" : "text-ink hover:bg-canvas-soft",
    className,
  ]}
  {...(external ? { rel: "noopener noreferrer", target: "_blank" } : {})}
>
  <span class="btn-arrow-icon">
    <ArrowUpRight
      aria-hidden="true"
      className={`size-5 ${tone === "light" ? "text-ink" : "text-white"}`}
    />
  </span>
  <span class:list={[tone === "light" ? "text-white" : "text-ink"]}>
    <slot />
  </span>
</a>
