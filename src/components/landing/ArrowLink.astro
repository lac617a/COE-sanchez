---
import { ArrowUpRight } from "lucide-react";

/** Botón píldora de contorno con la flecha ↗ a la izquierda, como en la referencia. */
type Props = {
  href: string;
  tone?: "dark" | "light";
  class?: string;
  external?: boolean;
};

const { href, tone = "dark", class: className, external = false } = Astro.props;
---

<a
  href={href}
  class:list={[
    "btn-pill",
    tone === "light"
      ? "border-white text-white hover:bg-white hover:!text-ink"
      : "border-ink text-ink hover:bg-ink hover:text-white",
    className,
  ]}
  {...(external ? { rel: "noopener noreferrer", target: "_blank" } : {})}
>
  <ArrowUpRight aria-hidden="true" className="size-4" strokeWidth={2} />
  <slot />
</a>
