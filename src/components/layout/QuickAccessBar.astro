---
import { Siren, Toothbrush, Utensils } from "lucide-react";

import { isCurrent, QUICK_LINKS } from "@/lib/nav";

const ICONS = { Urgencias: Siren, Alimentos: Utensils, Cepillado: Toothbrush } as const;
const pathname = Astro.url.pathname;
---

{/* Accesos rápidos fijos abajo en las guías: lo que el paciente busca con prisa. */}
<nav
  aria-label="Accesos rápidos"
  class="fixed inset-x-0 bottom-0 z-20 border-t border-line bg-surface/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-md xl:hidden"
>
  <ul class="mx-auto grid max-w-xl grid-cols-3 gap-2 px-3 py-1.5">
    {QUICK_LINKS.map(({ href, label }) => {
      const Icon = ICONS[label];
      return (
        <li>
          <a
            href={href}
            aria-current={isCurrent(pathname, href) ? "page" : undefined}
            class="flex tap flex-col items-center justify-center gap-0.5 rounded-2xl py-1 text-sm font-bold text-ink no-underline hover:bg-canvas-soft aria-[current=page]:bg-canvas-soft"
          >
            <Icon aria-hidden="true" className="size-6" strokeWidth={1.75} />
            {label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
