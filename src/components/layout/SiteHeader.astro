---
import { Image } from "astro:assets";
import { ArrowUpRight, Menu, MessageCircle, X } from "lucide-react";

import logoMark from "@/assets/brand/logo-mark.png";
import { TextSizeToggle } from "@/components/layout/text-size-toggle";
import { services } from "@/data/services";
import { clinic } from "@/lib/content";
import { isCurrent, MAIN_NAV } from "@/lib/nav";
import { clinicWhatsappUrl } from "@/lib/site";

type Props = { variant?: "light" | "dark" };

const { variant = "light" } = Astro.props;
const pathname = Astro.url.pathname;
const whatsappUrl = clinicWhatsappUrl();
---

<header class="site-header" data-variant={variant} data-site-header>
  <div class="container-page flex items-center justify-between gap-4 py-2.5">
    <a href="/" class="flex tap shrink-0 items-center no-underline">
      <Image
        src={logoMark}
        alt={`${clinic.brandMark}, ${clinic.name}. Ir al inicio`}
        width={96}
        loading="eager"
        class="h-10 w-auto"
      />
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {MAIN_NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link"
              aria-current={isCurrent(pathname, item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <TextSizeToggle client:idle />
      {whatsappUrl && (
        <a
          href={whatsappUrl}
          rel="noopener noreferrer"
          target="_blank"
          class="btn btn-secondary hidden md:inline-flex"
        >
          <MessageCircle aria-hidden="true" className="size-5" />
          Agendar cita
        </a>
      )}
      <button
        type="button"
        class="menu-button grid tap place-items-center rounded-full border border-line lg:hidden"
        aria-haspopup="dialog"
        aria-controls="menu-movil"
        data-menu-open
      >
        <Menu aria-hidden="true" className="size-6" />
        <span class="sr-only">Abrir menú</span>
      </button>
    </div>
  </div>
</header>

<dialog
  id="menu-movil"
  aria-label="Menú"
  class="surface-dark m-0 h-dvh max-h-none w-full max-w-none overflow-y-auto p-0 backdrop:bg-ink/60"
  data-menu
>
  <div class="container-page flex min-h-full flex-col py-3">
    <div class="flex items-center justify-between">
      <a href="/" class="flex tap items-center no-underline">
        <Image
          src={logoMark}
          alt={`${clinic.brandMark}. Ir al inicio`}
          width={96}
          class="h-10 w-auto"
        />
      </a>
      <button
        type="button"
        class="grid tap place-items-center rounded-full border border-white/40 text-white"
        data-menu-close
      >
        <X aria-hidden="true" className="size-6" />
        <span class="sr-only">Cerrar menú</span>
      </button>
    </div>

    <nav aria-label="Menú del celular" class="mt-10">
      <ul class="space-y-1">
        <li>
          <a href="/" class="font-display text-4xl italic no-underline">
            Inicio
          </a>
        </li>
        {MAIN_NAV.map((item) => (
          <li>
            <a href={item.href} class="font-display text-4xl italic no-underline">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-10 border-t border-line-inverse pt-6">
      <p class="eyebrow">Especialidades</p>
      <ul class="mt-3 grid gap-x-6 sm:grid-cols-2">
        {services.map((service) => (
          <li>
            <a
              href={`/especialidades/${service.slug}`}
              class="inline-flex min-h-tap items-center text-ink-inverse-muted no-underline hover:text-white"
            >
              {service.title}
            </a>
          </li>
        ))}
      </ul>
    </div>

    {whatsappUrl && (
      <a
        href={whatsappUrl}
        rel="noopener noreferrer"
        target="_blank"
        class="btn btn-light mt-auto mb-4 w-full"
      >
        Agendar cita por WhatsApp
        <ArrowUpRight aria-hidden="true" className="size-5" />
      </a>
    )}
  </div>
</dialog>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const dialog = document.querySelector<HTMLDialogElement>("[data-menu]");

  // Cabecera sólida al hacer scroll (sobre portadas oscuras empieza transparente).
  if (header) {
    const update = () => header.toggleAttribute("data-scrolled", window.scrollY > 24);
    update();
    window.addEventListener("scroll", update, { passive: true });
  }

  document.querySelector("[data-menu-open]")?.addEventListener("click", () => dialog?.showModal());
  document.querySelector("[data-menu-close]")?.addEventListener("click", () => dialog?.close());
  // Cerrar al elegir un enlace (también los anclas de la misma página).
  dialog?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) dialog.close();
  });
</script>
