---
import { Image } from "astro:assets";
import { CalendarClock, Menu, MessageCircle, Phone, X } from "lucide-react";

import logoMark from "@/assets/brand/logo-mark.png";
import InstagramIcon from "@/components/icons/InstagramIcon.astro";
import { TextSizeToggle } from "@/components/layout/text-size-toggle";
import { clinic } from "@/lib/content";
import { isCurrent, MAIN_NAV } from "@/lib/nav";
import { clinicInstagramUrl, clinicPhoneUrl, clinicWhatsappUrl } from "@/lib/site";

/**
 * Cabecera como la de la referencia: logo a la izquierda y menú lateral a la derecha.
 * `dark`: transparente sobre la portada oscura hasta hacer scroll.
 * `textSize`: muestra el botón A / A+ (solo en las guías).
 */
type Props = { variant?: "light" | "dark"; textSize?: boolean };

const { variant = "light", textSize = false } = Astro.props;
const pathname = Astro.url.pathname;
const whatsappUrl = clinicWhatsappUrl();
const phoneUrl = clinicPhoneUrl();
const instagramUrl = clinicInstagramUrl();
---

<header class="site-header" data-variant={variant} data-site-header>
  <div class="container-page flex items-center justify-between gap-4 py-3 sm:py-4">
    <a href="/" class="flex tap shrink-0 items-center no-underline">
      <Image
        src={logoMark}
        alt={`${clinic.brandMark}, ${clinic.name}. Ir al inicio`}
        width={120}
        loading="eager"
        class="h-11 w-auto sm:h-12"
      />
    </a>

    <div class="flex items-center gap-3">
      {textSize && <TextSizeToggle client:idle />}
      <button
        type="button"
        class="grid tap place-items-center rounded-lg"
        aria-haspopup="dialog"
        aria-controls="menu-principal"
        data-menu-open
      >
        <Menu aria-hidden="true" className="size-8" strokeWidth={1.75} />
        <span class="sr-only">Abrir menú</span>
      </button>
    </div>
  </div>
</header>

<dialog
  id="menu-principal"
  aria-label="Menú"
  class="menu-drawer m-0 h-dvh max-h-none w-[min(22rem,88vw)] max-w-none overflow-y-auto bg-white p-0 text-ink backdrop:bg-ink/50"
  data-menu
>
  <div class="flex min-h-full flex-col px-5 pt-4 pb-8">
    <div class="relative flex items-center justify-center">
      <a href="/" class="flex tap items-center no-underline">
        <Image
          src={logoMark}
          alt={`${clinic.brandMark}. Ir al inicio`}
          width={120}
          class="h-12 w-auto"
        />
      </a>
      <button
        type="button"
        class="absolute top-0 right-0 grid tap place-items-center"
        data-menu-close
      >
        <X aria-hidden="true" className="size-5" />
        <span class="sr-only">Cerrar menú</span>
      </button>
    </div>

    <nav aria-label="Principal" class="mt-8">
      <ul>
        {MAIN_NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(pathname, item.href) ? "page" : undefined}
              class="flex min-h-tap items-center text-[0.9375rem] font-semibold no-underline hover:underline aria-[current=page]:underline"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {whatsappUrl && (
      <a
        href={whatsappUrl}
        rel="noopener noreferrer"
        target="_blank"
        class="btn-pill mt-6 self-start border-ink text-ink hover:bg-ink hover:text-white"
      >
        <CalendarClock aria-hidden="true" className="size-5" strokeWidth={1.75} />
        Agende una cita
      </a>
    )}

    <div class="mt-8 space-y-1 text-sm">
      {phoneUrl && (
        <a href={phoneUrl} class="flex items-center gap-2 py-1 no-underline hover:underline">
          <Phone aria-hidden="true" className="size-4" />
          {clinic.phone}
        </a>
      )}
      {whatsappUrl && (
        <a
          href={whatsappUrl}
          rel="noopener noreferrer"
          target="_blank"
          class="flex items-center gap-2 py-1 no-underline hover:underline"
        >
          <MessageCircle aria-hidden="true" className="size-4" />
          WhatsApp
        </a>
      )}
    </div>

    {instagramUrl && (
      <a
        href={instagramUrl}
        rel="noopener noreferrer"
        target="_blank"
        class="mt-6 grid tap place-items-center self-start"
      >
        <InstagramIcon class="size-5" />
        <span class="sr-only">Instagram de la clínica</span>
      </a>
    )}
  </div>
</dialog>

<style>
  /* Menú lateral que entra desde la izquierda. */
  .menu-drawer[open] {
    animation: drawer-in 0.25s ease-out;
  }

  @keyframes drawer-in {
    from {
      translate: -100% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-drawer[open] {
      animation: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const dialog = document.querySelector<HTMLDialogElement>("[data-menu]");

  // Cabecera sólida al hacer scroll (sobre la portada oscura empieza transparente).
  if (header) {
    const update = () => header.toggleAttribute("data-scrolled", window.scrollY > 24);
    update();
    window.addEventListener("scroll", update, { passive: true });
  }

  document.querySelector("[data-menu-open]")?.addEventListener("click", () => dialog?.showModal());
  document.querySelector("[data-menu-close]")?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (event) => {
    // Cerrar al tocar fuera del panel o al elegir un enlace.
    if (event.target === dialog || (event.target as HTMLElement).closest("a")) dialog.close();
  });
</script>
