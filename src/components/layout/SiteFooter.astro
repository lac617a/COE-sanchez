---
import { Clock, MapPin, MessageCircle, Phone } from "lucide-react";

import InstagramIcon from "@/components/icons/InstagramIcon.astro";

import { getGuides, guideUrl } from "@/lib/guides";
import { clinic } from "@/lib/content";
import { MAIN_NAV } from "@/lib/nav";
import {
  clinicAddressLine,
  clinicInstagramUrl,
  clinicMapsUrl,
  clinicPhoneUrl,
  clinicWhatsappUrl,
} from "@/lib/site";

const guides = await getGuides();
const whatsappUrl = clinicWhatsappUrl();
const phoneUrl = clinicPhoneUrl();
const instagramUrl = clinicInstagramUrl();
---

<footer class="surface-dark">
  <div class="container-page border-b border-line-inverse py-14 sm:py-20">
    <h2 class="text-4xl italic sm:text-6xl">¿Hablamos de su sonrisa?</h2>
    <p class="mt-4 max-w-xl text-lg text-ink-inverse-muted">
      Escríbanos y le ayudamos a encontrar un horario para su valoración.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      {whatsappUrl && (
        <a href={whatsappUrl} rel="noopener noreferrer" target="_blank" class="btn btn-light">
          <MessageCircle aria-hidden="true" className="size-5" />
          Escribir por WhatsApp
        </a>
      )}
      {phoneUrl && (
        <a href={phoneUrl} class="btn btn-outline-light">
          <Phone aria-hidden="true" className="size-5" />
          {clinic.phone}
        </a>
      )}
    </div>
  </div>

  <div class="container-page grid gap-10 py-14 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
    <div class="space-y-3">
      <p class="font-display text-3xl">{clinic.name}</p>
      <p class="max-w-sm text-ink-inverse-muted">{clinic.tagline}.</p>
      {instagramUrl && (
        <a
          href={instagramUrl}
          rel="noopener noreferrer"
          target="_blank"
          class="inline-flex tap items-center gap-2"
        >
          <InstagramIcon class="size-5" />
          {clinic.instagram}
        </a>
      )}
    </div>

    <nav aria-label="Sitio">
      <p class="eyebrow">Clínica</p>
      <ul class="mt-3 space-y-1">
        <li>
          <a href="/" class="inline-flex min-h-tap items-center no-underline hover:underline">
            Inicio
          </a>
        </li>
        {MAIN_NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class="inline-flex min-h-tap items-center no-underline hover:underline"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Guías del pie de página">
      <p class="eyebrow">Guías</p>
      <ul class="mt-3 space-y-1">
        {guides.map((guide) => (
          <li>
            <a
              href={guideUrl(guide.data.slug)}
              class="inline-flex min-h-tap items-center no-underline hover:underline"
            >
              {guide.data.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <p class="eyebrow">Contacto</p>
      <div class="mt-4 space-y-3 text-ink-inverse-muted">
        <p class="flex items-start gap-2">
          <MapPin aria-hidden="true" className="mt-1 size-5 shrink-0 text-white" />
          <span>
            {clinicAddressLine()}.{" "}
            <a href={clinicMapsUrl()} rel="noopener noreferrer" target="_blank">
              Cómo llegar
            </a>
          </span>
        </p>
        {clinic.hours && (
          <p class="flex items-start gap-2">
            <Clock aria-hidden="true" className="mt-1 size-5 shrink-0 text-white" />
            {clinic.hours}
          </p>
        )}
      </div>
    </div>
  </div>

  <div class="border-t border-line-inverse">
    <div class="container-page flex flex-wrap items-center justify-between gap-4 py-5 text-base text-ink-inverse-muted">
      <p>
        © {new Date().getFullYear()} {clinic.name}
      </p>
      <a href="/creditos" class="inline-flex tap items-center">
        Créditos
      </a>
    </div>
  </div>
</footer>
