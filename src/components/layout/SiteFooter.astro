---
import { Image } from "astro:assets";
import { MessageCircle } from "lucide-react";

import logoMark from "@/assets/brand/logo-mark.png";
import InstagramIcon from "@/components/icons/InstagramIcon.astro";
import { clinic } from "@/lib/content";
import { GUIDES_BASE } from "@/lib/guides";
import {
  clinicAddressLine,
  clinicInstagramUrl,
  clinicMapsUrl,
  clinicPhoneUrl,
  clinicWhatsappUrl,
} from "@/lib/site";

const whatsappUrl = clinicWhatsappUrl();
const phoneUrl = clinicPhoneUrl();
const instagramUrl = clinicInstagramUrl();

type FooterLink = { href: string; label: string; external?: boolean };

const COLUMNS: Array<{ title: string; links: FooterLink[] }> = [
  {
    title: "Explora",
    links: [
      { href: "/quienes-somos", label: "Quiénes somos" },
      { href: "/especialidades", label: "Especialidades" },
      ...(whatsappUrl ? [{ href: whatsappUrl, label: "Agendar cita", external: true }] : []),
    ],
  },
  {
    title: "Pacientes",
    links: [
      { href: GUIDES_BASE, label: "Guías de ortodoncia" },
      { href: `${GUIDES_BASE}/urgencias`, label: "Qué hacer en una urgencia" },
    ],
  },
  {
    title: "Encuéntrenos",
    links: [
      { href: clinicMapsUrl(), label: "Cómo llegar", external: true },
      ...(instagramUrl ? [{ href: instagramUrl, label: "Instagram", external: true }] : []),
      { href: "/creditos", label: "Créditos" },
    ],
  },
];
---

<footer class="mt-auto border-t border-line bg-white">
  <div class="container-page grid gap-10 py-14 md:grid-cols-[1.2fr_2fr] md:gap-16">
    <div>
      <p class="font-display text-[1.75rem] leading-tight text-[#333] italic">
        ¿Listo/a para transformar su sonrisa?
      </p>
      <div class="mt-4 space-y-1 text-[0.9375rem] text-[#333]">
        {phoneUrl && (
          <a href={phoneUrl} class="block no-underline hover:underline">
            {clinic.phone}
          </a>
        )}
        <p>{clinicAddressLine()}.</p>
        {clinic.hours && <p class="text-ink-muted">{clinic.hours}</p>}
      </div>
      <div class="mt-5 flex items-center gap-2">
        {instagramUrl && (
          <a
            href={instagramUrl}
            rel="noopener noreferrer"
            target="_blank"
            class="grid tap place-items-center"
          >
            <InstagramIcon class="size-5" />
            <span class="sr-only">Instagram</span>
          </a>
        )}
        {whatsappUrl && (
          <a
            href={whatsappUrl}
            rel="noopener noreferrer"
            target="_blank"
            class="grid tap place-items-center"
          >
            <MessageCircle aria-hidden="true" className="size-5" />
            <span class="sr-only">WhatsApp</span>
          </a>
        )}
      </div>
    </div>

    <div class="grid gap-8 sm:grid-cols-3">
      {COLUMNS.map((column) => (
        <nav aria-label={column.title}>
          <p class="text-[0.9375rem] font-bold text-[#333]">{column.title}</p>
          <ul class="mt-3 space-y-1">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-9 items-center text-[0.9375rem] text-ink-muted no-underline hover:text-ink hover:underline"
                  {...(link.external ? { rel: "noopener noreferrer", target: "_blank" } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>

  <div class="border-t border-line">
    <div class="container-page flex flex-wrap items-center justify-between gap-4 py-5 text-[0.8125rem] text-[#807981]">
      <p>
        © {new Date().getFullYear()} {clinic.name}. Todos los derechos reservados.
      </p>
      <Image src={logoMark} alt="" width={48} class="h-6 w-auto opacity-80" />
    </div>
  </div>
</footer>
