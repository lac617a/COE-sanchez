---
import { render } from "astro:content";
import { ArrowUpRight } from "lucide-react";

import Callout from "@/components/content/Callout.astro";
import Card from "@/components/content/Card.astro";
import Cards from "@/components/content/Cards.astro";
import { ClinicalDisclaimer } from "@/components/content/clinical-disclaimer";
import { EmergencyAlert, EmergencyGuide } from "@/components/content/emergency-guide";
import FoodGuide from "@/components/content/FoodGuide.astro";
import { HygieneKitGuide } from "@/components/content/hygiene-kit-guide";
import MdxLink from "@/components/content/MdxLink.astro";
import { Param } from "@/components/content/param";
import { ReviewStamp } from "@/components/content/review-stamp";
import { SourcesList } from "@/components/content/sources-list";
import { ArcLine } from "@/components/illustrations/decor";
import { GuideArt } from "@/components/illustrations/guide-art";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getGuides, GUIDES_BASE, guideUrl } from "@/lib/guides";
import { breadcrumbJsonLd, medicalWebPageJsonLd } from "@/lib/seo";

import type { Guide } from "@/lib/guides";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const guides = await getGuides();
  return guides.map((guide, index) => ({
    params: { slug: guide.data.slug },
    props: { guide, number: index + 1 },
  }));
}) satisfies GetStaticPaths;

type Props = { guide: Guide; number: number };

const { guide, number } = Astro.props;
const { data } = guide;
const { Content } = await render(guide);

const guides = await getGuides();
const related = data.related
  .map((slug) => guides.find((item) => item.data.slug === slug))
  .filter((item) => item !== undefined);

/** Componentes disponibles dentro de los archivos MDX de src/content/guias. */
const components = {
  a: MdxLink,
  Callout,
  Card,
  Cards,
  EmergencyAlert,
  EmergencyGuide,
  FoodGuide,
  HygieneKitGuide,
  Param,
};
---

<BaseLayout
  title={data.seoTitle}
  description={data.description}
  ogType="article"
  area="guias"
  jsonLd={[
    medicalWebPageJsonLd(guide),
    breadcrumbJsonLd([
      { name: "Inicio", path: "/" },
      { name: "Guías", path: GUIDES_BASE },
      { name: data.title, path: guideUrl(data.slug) },
    ]),
  ]}
>
  <article>
    <header class="container-page pt-3 sm:pt-5">
      <div class="card-soft relative isolate overflow-hidden px-6 py-8 sm:px-10 sm:py-12 md:grid md:grid-cols-[1fr_auto] md:items-center md:gap-12 md:px-14">
        <ArcLine className="pointer-events-none absolute -right-20 -bottom-16 -z-10 w-[36rem] max-w-none text-ink/15" />
        <div>
          <nav aria-label="Ruta de navegación" class="text-base">
            <ol class="flex flex-wrap gap-2 text-ink-muted">
              <li>
                <a href="/">Inicio</a>
              </li>
              <li aria-hidden="true">/</li>
              <li>
                <a href={GUIDES_BASE}>Guías</a>
              </li>
              <li aria-hidden="true">/</li>
              <li aria-current="page">{data.title}</li>
            </ol>
          </nav>
          <p class="eyebrow mt-6">Guía {String(number).padStart(2, "0")}</p>
          <h1 class="mt-3 text-4xl sm:text-5xl lg:text-6xl">{data.title}</h1>
          {data.lead && <p class="mt-5 max-w-xl text-xl text-ink-muted">{data.lead}</p>}
          <div class="mt-6">
            <ReviewStamp review={data.review} />
          </div>
        </div>
        <div class="mt-8 grid size-40 place-items-center rounded-full bg-white shadow-[var(--shadow-soft)] max-md:mx-auto md:mt-0 md:size-56">
          <GuideArt slug={data.slug} className="parallax size-24 [--parallax:1rem] md:size-36" />
        </div>
      </div>
    </header>

    <div class="container-text pt-10">
      <ClinicalDisclaimer />
      <div class="content mt-6">
        <Content components={components} />
      </div>
    </div>

    {related.length > 0 && (
      <nav aria-labelledby="relacionados" class="container-page mt-10">
        <div class="border-t border-line pt-12">
          <p class="eyebrow">Siga leyendo</p>
          <h2 id="relacionados" class="mt-2 text-3xl sm:text-4xl">
            También le puede servir
          </h2>
          <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((item) => (
              <li>
                <a
                  href={guideUrl(item.data.slug)}
                  class="card-soft group flex tap items-center gap-4 p-4 font-bold no-underline transition-shadow hover:shadow-[var(--shadow-soft)]"
                >
                  <span class="grid size-16 shrink-0 place-items-center rounded-2xl bg-white">
                    <GuideArt slug={item.data.slug} decorative className="size-11" />
                  </span>
                  <span class="flex-1">{item.data.title}</span>
                  <span class="grid size-10 shrink-0 place-items-center rounded-full border border-ink/25 bg-white transition-colors group-hover:bg-ink group-hover:text-white">
                    <ArrowUpRight aria-hidden="true" className="size-5" />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )}

    <div class="container-text mt-14 mb-16">
      <SourcesList sources={data.sources} />
    </div>
  </article>
</BaseLayout>
