---
import { ArrowUpRight, Check, ChevronDown, MessageCircle, Phone } from "lucide-react";

import bracesPhoto from "@/assets/brand/ortodoncia-brackets.jpg";
import ArrowLink from "@/components/landing/ArrowLink.astro";
import PageHero from "@/components/landing/PageHero.astro";
import PhotoSlot from "@/components/landing/PhotoSlot.astro";
import ServiceCard from "@/components/landing/ServiceCard.astro";
import ServiceIcon from "@/components/landing/ServiceIcon.astro";
import { CATEGORIES, services } from "@/data/services";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getGuides, GUIDES_BASE } from "@/lib/guides";
import { breadcrumbJsonLd, faqJsonLd, serviceJsonLd } from "@/lib/seo";
import { clinicPhoneUrl, clinicWhatsappUrl } from "@/lib/site";

import type { Service } from "@/data/services";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (() =>
  services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }))) satisfies GetStaticPaths;

type Props = { service: Service };

const { service } = Astro.props;
const path = `/especialidades/${service.slug}`;
const whatsappUrl = clinicWhatsappUrl(`Hola, quisiera una valoración de ${service.title}.`);
const phoneUrl = clinicPhoneUrl();

const allGuides = await getGuides();
const guides = service.guides
  .map((slug) => allGuides.find((guide) => guide.data.slug === slug))
  .filter((guide) => guide !== undefined);
const others = services.filter(
  (item) => item.category === service.category && item.slug !== service.slug,
);
// Única foto real disponible por ahora: la de brackets, solo para ortodoncia con brackets.
const photo = ["ortodoncia-convencional", "ortodoncia-autoligado"].includes(service.slug)
  ? bracesPhoto
  : undefined;
---

<BaseLayout
  title={service.title}
  description={service.description}
  headerVariant="dark"
  jsonLd={[
    serviceJsonLd(service, path),
    faqJsonLd(service.faqs),
    breadcrumbJsonLd([
      { name: "Inicio", path: "/" },
      { name: "Especialidades", path: "/especialidades" },
      { name: service.title, path },
    ]),
  ]}
>
  <PageHero
    title={service.title}
    crumbs={[
      { name: "Inicio", href: "/" },
      { name: "Especialidades", href: "/especialidades" },
      { name: service.title },
    ]}
  >
    <p>{service.intro}</p>

    <!-- En la referencia aquí va un formulario; usamos WhatsApp para no recoger datos personales. -->
    <div slot="aside" class="grid gap-4">
      <PhotoSlot
        src={photo}
        alt={photo ? "Brackets con arco y ligas de color." : ""}
        label={service.title}
        tone="dark"
        class="aspect-[16/10]"
        eager
      />
      <div class="rounded-[var(--radius-card)] border border-line-inverse bg-white/5 p-6 backdrop-blur-sm">
        <p class="font-display text-2xl">Hable con un especialista</p>
        <p class="mt-1 text-ink-inverse-muted">Escríbanos y le ayudamos a agendar su valoración.</p>
        <div class="mt-5 flex flex-wrap gap-3">
          {whatsappUrl && (
            <a href={whatsappUrl} rel="noopener noreferrer" target="_blank" class="btn btn-light">
              <MessageCircle aria-hidden="true" className="size-5" />
              WhatsApp
            </a>
          )}
          {phoneUrl && (
            <a href={phoneUrl} class="btn btn-outline-light">
              <Phone aria-hidden="true" className="size-5" />
              Llamar
            </a>
          )}
        </div>
      </div>
    </div>
  </PageHero>

  <!-- Cómo funciona -->
  <section aria-labelledby="como-funciona" class="container-page py-16 sm:py-24">
    <div class="rounded-[var(--radius-panel)] bg-ink px-6 py-12 text-white sm:px-12 sm:py-16">
      <div class="grid gap-10 lg:grid-cols-[1fr_2fr] lg:gap-16">
        <div>
          <span
            class="grid size-14 place-items-center rounded-2xl bg-white/10 text-brand-300"
            aria-hidden="true"
          >
            <ServiceIcon icon={service.icon} class="size-7" />
          </span>
          <h2 id="como-funciona" class="section-title mt-5">
            ¿Cómo funciona?
          </h2>
        </div>
        <ol class="grid gap-8 sm:grid-cols-3">
          {service.steps.map((step, index) => (
            <li class="border-t border-line-inverse pt-5">
              <span class="grid size-9 place-items-center rounded-full bg-white font-bold text-ink">
                {index + 1}
              </span>
              <h3 class="mt-4 text-lg text-white">{step.title}</h3>
              <p class="mt-2 text-ink-inverse-muted">{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section aria-labelledby="por-que" class="container-page pb-16 sm:pb-24">
    <h2 id="por-que" class="section-title max-w-2xl">
      ¿Por qué elegir <span class="italic">este tratamiento</span>?
    </h2>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {service.benefits.map((benefit) => (
        <li class="card-soft reveal p-6">
          <span class="grid size-10 place-items-center rounded-full bg-white">
            <Check aria-hidden="true" className="size-5 text-brand-600" strokeWidth={2.5} />
          </span>
          <h3 class="mt-4 text-lg">{benefit.title}</h3>
          <p class="mt-1 text-ink-muted">{benefit.text}</p>
        </li>
      ))}
    </ul>
  </section>

  {guides.length > 0 && (
    <section aria-label="Guías para pacientes" class="container-page pb-4">
      <a
        href={GUIDES_BASE}
        class="card-gray group flex flex-wrap items-center justify-between gap-4 p-5 no-underline sm:p-6"
      >
        <span>
          <span class="block font-bold">¿Ya es paciente?</span>
          <span class="text-[0.9375rem] text-[#333]">
            Vea nuestras guías para cuidar sus brackets en casa:{" "}
            {guides.map((guide) => guide.data.title.toLowerCase()).join(", ")}.
          </span>
        </span>
        <span class="btn-pill border-ink text-ink group-hover:bg-ink group-hover:text-white">
          <ArrowUpRight aria-hidden="true" className="size-4" />
          Ver guías
        </span>
      </a>
    </section>
  )}

  <!-- Preguntas frecuentes -->
  <section aria-labelledby="faq" class="container-page pt-8 pb-16 sm:pt-12 sm:pb-24">
    <div class="grid gap-10 lg:grid-cols-[1fr_2fr] lg:gap-16">
      <div>
        <h2 id="faq" class="section-title">
          Preguntas frecuentes
        </h2>
        <p class="mt-3 text-lg text-ink-muted">Resolvemos sus dudas antes de su primera visita.</p>
      </div>
      <ul class="space-y-3">
        {service.faqs.map((faq) => (
          <li>
            <details
              name="faq"
              class="group rounded-[var(--radius-card)] border border-line bg-surface transition-shadow open:shadow-[var(--shadow-soft)]"
            >
              <summary class="flex min-h-tap items-center justify-between gap-4 p-5 text-lg font-bold">
                {faq.q}
                <ChevronDown
                  aria-hidden="true"
                  className="size-6 shrink-0 transition-transform group-open:rotate-180"
                />
              </summary>
              <p class="border-t border-line px-5 pt-3 pb-5 text-ink-muted">{faq.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {others.length > 0 && (
    <section aria-labelledby="otras" class="container-page pb-16 sm:pb-24">
      <div class="flex flex-wrap items-end justify-between gap-6 border-t border-line pt-12">
        <h2 id="otras" class="section-title">
          Más en {CATEGORIES[service.category].title.toLowerCase()}
        </h2>
        <ArrowLink href="/especialidades">Todas las especialidades</ArrowLink>
      </div>
      <ul class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {others.map((item) => (
          <li>
            <ServiceCard service={item} />
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
