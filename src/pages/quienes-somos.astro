---
import { Image } from "astro:assets";
import {
  BookOpenCheck,
  Clock,
  FlaskConical,
  MapPin,
  MessageCircle,
  Phone,
  ScanLine,
  Smile,
} from "lucide-react";

import logoFull from "@/assets/brand/logo-full.png";
import PageHero from "@/components/landing/PageHero.astro";
import PhotoSlot from "@/components/landing/PhotoSlot.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { clinic } from "@/lib/content";
import { breadcrumbJsonLd, dentistJsonLd } from "@/lib/seo";
import { clinicAddressLine, clinicMapsUrl, clinicPhoneUrl, clinicWhatsappUrl } from "@/lib/site";

const whatsappUrl = clinicWhatsappUrl();
const phoneUrl = clinicPhoneUrl();

const VALUES = [
  {
    Icon: FlaskConical,
    title: "Laboratorio propio",
    text: "Diseñamos y fabricamos en la clínica alineadores y lentes dentales, sin depender de terceros.",
  },
  {
    Icon: ScanLine,
    title: "Tecnología 3D",
    text: "Escaneamos y planificamos cada tratamiento en la computadora antes de empezar.",
  },
  {
    Icon: Smile,
    title: "AlineaPro",
    text: "Creamos nuestra propia marca de alineadores transparentes para ortodoncia invisible.",
  },
  {
    Icon: BookOpenCheck,
    title: "Pacientes informados",
    text: "Preparamos guías sencillas para que cuide su tratamiento en casa, sin dudas.",
  },
];
---

<BaseLayout
  title="Quiénes somos"
  description={`Conozca la ${clinic.name}: especialistas en ortodoncia y estética dental en Bucaramanga, con laboratorio propio y tecnología 3D.`}
  headerVariant="dark"
  jsonLd={[
    dentistJsonLd(),
    breadcrumbJsonLd([
      { name: "Inicio", path: "/" },
      { name: "Quiénes somos", path: "/quienes-somos" },
    ]),
  ]}
>
  <PageHero
    title="Quiénes somos"
    crumbs={[{ name: "Inicio", href: "/" }, { name: "Quiénes somos" }]}
  >
    <p>
      Somos una clínica especializada en ortodoncia y estética dental en Bucaramanga. Unimos la
      experiencia clínica con laboratorio propio y tecnología 3D para planificar cada tratamiento a
      la medida de cada paciente.
    </p>
    <PhotoSlot
      slot="aside"
      label="fachada o recepción de la clínica"
      tone="dark"
      class="aspect-[4/3]"
    />
  </PageHero>

  <!-- Equipo -->
  <section aria-labelledby="equipo" class="container-page py-16 sm:py-24">
    <p class="eyebrow">Nuestro equipo</p>
    <h2 id="equipo" class="section-title mt-2">
      Los especialistas detrás de su sonrisa
    </h2>
    <ul class="mt-10 grid gap-6 md:grid-cols-2">
      {clinic.doctors.map((doctor) => (
        <li class="card-soft overflow-hidden p-3">
          <PhotoSlot label={doctor.name} class="aspect-[4/3] rounded-[1.25rem]" />
          <div class="p-4 sm:p-6">
            <h3 class="font-display text-3xl font-normal">{doctor.name}</h3>
            <p class="mt-1 text-ink-muted">{doctor.specialty}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- Lo que nos define -->
  <section aria-labelledby="define" class="container-page pb-16 sm:pb-24">
    <div class="surface-dark rounded-[var(--radius-panel)] px-6 py-12 sm:px-12 sm:py-16">
      <div class="grid gap-10 lg:grid-cols-[1fr_2fr] lg:gap-16">
        <div>
          <p class="eyebrow">Cómo trabajamos</p>
          <h2 id="define" class="section-title mt-3">
            Lo que nos define
          </h2>
        </div>
        <ul class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
          {VALUES.map(({ Icon, title, text }) => (
            <li class="border-t border-line-inverse pt-5">
              <Icon aria-hidden="true" className="size-7 text-brand-300" strokeWidth={1.5} />
              <h3 class="mt-3 text-xl">{title}</h3>
              <p class="mt-2 text-ink-inverse-muted">{text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Dónde estamos -->
  <section aria-labelledby="clinica" class="bg-canvas-soft py-16 sm:py-24">
    <div class="container-page grid items-center gap-10 md:grid-cols-2 md:gap-16">
      <div class="rounded-[var(--radius-panel)] bg-white p-8 shadow-[var(--shadow-soft)] sm:p-12">
        <Image
          src={logoFull}
          alt={`${clinic.brandMark}: ${clinic.tagline}`}
          widths={[400, 800]}
          sizes="(min-width: 768px) 480px, 90vw"
          class="mx-auto h-auto w-full max-w-sm"
        />
      </div>

      <div>
        <p class="eyebrow">Visítenos</p>
        <h2 id="clinica" class="section-title mt-3">
          Dónde estamos
        </h2>
        <p class="mt-5 text-lg font-bold">{clinic.name}</p>
        <p class="mt-3 flex items-start gap-2">
          <MapPin aria-hidden="true" className="mt-1 size-5 shrink-0" />
          {clinicAddressLine()}
        </p>
        {clinic.hours && (
          <p class="mt-1 flex items-start gap-2">
            <Clock aria-hidden="true" className="mt-1 size-5 shrink-0" />
            {clinic.hours}
          </p>
        )}
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          {whatsappUrl && (
            <a href={whatsappUrl} rel="noopener noreferrer" target="_blank" class="btn btn-primary">
              <MessageCircle aria-hidden="true" className="size-5" />
              Escribir por WhatsApp
            </a>
          )}
          {phoneUrl && (
            <a href={phoneUrl} class="btn btn-secondary">
              <Phone aria-hidden="true" className="size-5" />
              Llamar
            </a>
          )}
          <a
            href={clinicMapsUrl()}
            rel="noopener noreferrer"
            target="_blank"
            class="btn btn-secondary"
          >
            <MapPin aria-hidden="true" className="size-5" />
            Cómo llegar
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
