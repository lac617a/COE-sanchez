---
import { ArrowUpRight, FlaskConical, ScanLine, Smile, UsersRound } from "lucide-react";

import InstagramIcon from "@/components/icons/InstagramIcon.astro";
import { ArcLine } from "@/components/illustrations/decor";
import ArrowLink from "@/components/landing/ArrowLink.astro";
import HeroCarousel from "@/components/landing/HeroCarousel.astro";
import PhotoSlot from "@/components/landing/PhotoSlot.astro";
import ServicesArc from "@/components/landing/ServicesArc.astro";
import { PHOTOS } from "@/data/photos";
import { services } from "@/data/services";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { clinic } from "@/lib/content";
import { dentistJsonLd, websiteJsonLd } from "@/lib/seo";
import { clinicInstagramUrl } from "@/lib/site";

const instagramUrl = clinicInstagramUrl();

/** Cifras que salen de los datos del sitio: nada inventado ni publicitario. */
const STATS = [
  {
    value: String(clinic.doctors.length),
    label: "Especialistas a cargo de su tratamiento",
    avatars: true,
  },
  { value: "3D", label: "Tecnología para planificar y fabricar" },
  { value: String(services.length), label: "Tratamientos, todo en un solo lugar" },
  { value: "1", label: "Marca propia de ortodoncia invisible: AlineaPro" },
];

const DIFFERENCE = [
  {
    Icon: FlaskConical,
    title: "Laboratorio propio",
    text: "Diseñamos y fabricamos en la clínica alineadores y lentes dentales.",
  },
  {
    Icon: UsersRound,
    title: "Especialistas a cargo",
    text: "Ortodoncia y estética dental en manos de sus especialistas.",
  },
  {
    Icon: ScanLine,
    title: "Tecnología 3D",
    text: "Escaneo y planificación digital para resultados precisos.",
  },
  {
    Icon: Smile,
    title: "Plan a su medida",
    text: "Un plan de tratamiento pensado para cada paciente.",
  },
];

const ALINEAPRO_TAGS = ["Transparentes", "Removibles", "Hechos a la medida", "Laboratorio propio"];

/** Temas de las historias destacadas del Instagram de la clínica. */
const INSTAGRAM_TOPICS = ["Ortodoncia", "Diseños de sonrisa", "Microdiseño", "Planificación"];

function initials(name: string): string {
  return name
    .replace(/^(Dra?\.)\s+/, "")
    .split(/\s+/)
    .filter((part) => /^[A-ZÁÉÍÓÚÑ]/.test(part))
    .slice(0, 2)
    .map((part) => part[0])
    .join("");
}
---

<BaseLayout headerVariant="dark" jsonLd={[websiteJsonLd(), dentistJsonLd()]}>
  <!-- Portada -->
  <section class="hero-surface">
    <div class="container-page grid gap-10 pt-28 pb-0 sm:pt-32 md:min-h-[36rem] md:grid-cols-[1fr_1fr] md:items-center md:gap-6 md:pt-24">
      <div class="md:pb-16">
        <h1 class="display-title italic">Su sonrisa, diseñada a su medida</h1>
        <p class="mt-8 max-w-md text-lg leading-snug text-white/90">
          Clínica de ortodoncia y estética dental en Bucaramanga, con laboratorio propio y
          tecnología 3D para cuidar cada detalle de su tratamiento.
        </p>
        <ArrowLink href="/quienes-somos" tone="light" class="mt-8">
          Conozca más
        </ArrowLink>
      </div>
      <div class="self-end overflow-hidden pt-4 md:pt-10">
        <div class="translate-y-[10%]">
          <HeroCarousel
            slides={[
              PHOTOS.pacienteOrtodoncia,
              PHOTOS.sonrisaEstetica,
              PHOTOS.pacienteEstetica,
              PHOTOS.brackets,
            ]}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Presentación -->
  <section aria-labelledby="presentacion" class="container-page pt-16 pb-16 sm:pt-20 sm:pb-24">
    <h2 id="presentacion" class="display-title text-center text-ink">
      Ortodoncia y estética dental en Bucaramanga.
    </h2>
    <svg
      aria-hidden="true"
      viewBox="0 0 160 20"
      fill="none"
      class="mx-auto mt-2 h-6 w-36 text-ink sm:w-44"
    >
      <path
        d="M4 4 C 40 22, 120 22, 156 4"
        stroke="currentColor"
        stroke-width="4"
        stroke-linecap="round"
      ></path>
    </svg>

    <div class="mx-auto mt-10 max-w-[53rem]">
      <div class="grid grid-cols-[1fr_1.35fr_1fr] items-start gap-3 px-[4%] sm:gap-6">
        <PhotoSlot
          {...PHOTOS.drJose}
          label="Dr. José David Quintero"
          class="mt-8 aspect-[8/9]"
          sizes="(min-width: 768px) 15rem, 30vw"
        />
        <PhotoSlot
          {...PHOTOS.sonrisaEstetica}
          label="sonrisa"
          class="aspect-[282/260]"
          sizes="(min-width: 768px) 20rem, 40vw"
        />
        <PhotoSlot
          {...PHOTOS.draLorena}
          label="Dra. Lorena Sánchez"
          class="mt-8 aspect-[8/9]"
          sizes="(min-width: 768px) 15rem, 30vw"
        />
      </div>
      <div class="relative -mt-8 rounded-[1.25rem] bg-black px-6 pt-14 pb-10 text-center text-white sm:-mt-14 sm:px-14 sm:pt-20">
        <h3 class="section-title text-white">Especialistas en ortodoncia y diseño de sonrisa</h3>
        <p class="mx-auto mt-4 max-w-2xl text-[0.9375rem] leading-relaxed text-white/90">
          La clínica lleva el nombre de sus especialistas: la Dra. Lorena Sánchez Lázaro y el Dr.
          José David Quintero. Con laboratorio propio y tecnología 3D, diseñamos y fabricamos en la
          clínica buena parte de lo que usa su tratamiento.
        </p>
        <ArrowLink href="/quienes-somos" tone="light" class="mt-8">
          Conózcanos
        </ArrowLink>
      </div>
    </div>
  </section>

  <!-- Especialidades -->
  <section aria-labelledby="especialidades" class="relative isolate overflow-hidden pb-10 sm:pb-16">
    <div class="container-page flex flex-wrap items-start justify-between gap-6">
      <div class="max-w-xl">
        <h2 id="especialidades" class="section-title">
          Nuestras especialidades
        </h2>
        <p class="mt-4 text-[0.9375rem] text-[#333]">
          Tratamientos diseñados para cada necesidad, con la tecnología y el laboratorio de la
          clínica.
        </p>
      </div>
      <ArrowLink href="/especialidades">Todas las especialidades</ArrowLink>
    </div>
    <div class="mt-10">
      <ServicesArc services={services} />
    </div>
  </section>

  <!-- Cifras -->
  <section aria-labelledby="cifras" class="container-page pb-16 sm:pb-24">
    <h2 id="cifras" class="sr-only">
      La clínica en cifras
    </h2>
    <div class="mx-auto max-w-[53rem] rounded-[1.75rem] bg-[#040006] px-6 py-8 text-white sm:px-12 sm:py-10">
      <ul class="grid sm:grid-cols-2">
        {STATS.map((stat, index) => (
          <li
            class:list={[
              "flex items-center gap-4 py-6 sm:px-6",
              index % 2 === 0 && "sm:border-r sm:border-white/20",
              index < 2 && "border-b border-white/20",
              index === 2 && "max-sm:border-b max-sm:border-white/20",
            ]}
          >
            {stat.avatars && (
              <span aria-hidden="true" class="flex -space-x-3">
                {clinic.doctors.map((doctor) => (
                  <span class="grid size-11 place-items-center rounded-full border-2 border-[#040006] bg-brand-300 text-sm font-bold text-ink">
                    {initials(doctor.name)}
                  </span>
                ))}
              </span>
            )}
            <span class="min-w-[4.5rem] text-[2.5rem] leading-none font-light text-white/85">
              {stat.value}
            </span>
            <span class="text-[0.9375rem] leading-snug text-white/90">{stat.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- La diferencia -->
  <section aria-labelledby="diferencia" class="container-page pb-16 sm:pb-24">
    <div class="mx-auto grid max-w-[53rem] items-center gap-10 md:grid-cols-2 md:gap-12">
      <div>
        <h2 id="diferencia" class="section-title">
          La diferencia {clinic.brandMark}
        </h2>
        <ul class="mt-8 grid grid-cols-2 gap-x-6 gap-y-7">
          {DIFFERENCE.map(({ Icon, title, text }) => (
            <li>
              <span class="flex items-center gap-3">
                <span class="icon-chip shrink-0">
                  <Icon aria-hidden="true" className="size-4" strokeWidth={1.75} />
                </span>
                <h3 class="text-[1.0625rem] leading-tight font-bold">{title}</h3>
              </span>
              <p class="mt-3 text-[0.9375rem] leading-snug text-[#333]">{text}</p>
            </li>
          ))}
        </ul>
      </div>
      <div class="relative">
        <PhotoSlot
          {...PHOTOS.sonrisaIntraoral}
          label="sonrisa intraoral"
          tone="dark"
          class="aspect-[4/3.2] !rounded-[1.25rem_1.25rem_1.25rem_12.5rem]"
        />
      </div>
    </div>
  </section>

  <!-- AlineaPro (en la referencia: convenios corporativos) -->
  <section aria-labelledby="alineapro" class="relative isolate overflow-hidden pb-16 sm:pb-24">
    <ArcLine className="pointer-events-none absolute top-0 -left-40 -z-10 w-[42rem] max-w-none text-ink/25" />
    <div class="container-page">
      <div class="mx-auto grid max-w-[53rem] items-center gap-10 md:grid-cols-2 md:gap-12">
        <PhotoSlot
          label="alineadores AlineaPro"
          class="order-2 aspect-[3/2] !rounded-[1.75rem_12.5rem_1.75rem_1.75rem] md:order-1"
        />
        <div class="order-1 md:order-2">
          <h2 id="alineapro" class="section-title">
            Ortodoncia invisible con AlineaPro
          </h2>
          <p class="mt-4 text-[0.9375rem] leading-relaxed text-[#333]">
            AlineaPro es nuestra propia marca de alineadores transparentes. Los diseñamos con
            tecnología 3D y los fabricamos en el laboratorio de la clínica, a la medida de su
            sonrisa.
          </p>
          <ArrowLink href="/especialidades/ortodoncia-invisible" class="mt-6">
            Más información
          </ArrowLink>
          <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
            {ALINEAPRO_TAGS.map((tag) => (
              <li class="grid min-h-16 place-items-center rounded-2xl bg-white px-2 text-center text-xs font-bold shadow-[0_2px_12px_rgb(0_0_0/0.08)]">
                {tag}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Instagram -->
  {instagramUrl && (
    <section aria-labelledby="instagram" class="pb-16 sm:pb-24">
      <h2 id="instagram" class="section-title container-page text-center">
        Síganos como {clinic.instagram}
      </h2>
      <ul class="mt-10 flex snap-x gap-4 overflow-x-auto px-4 pb-2 [scrollbar-width:none] sm:justify-center [&::-webkit-scrollbar]:hidden">
        {INSTAGRAM_TOPICS.map((topic) => (
          <li class="w-[13.5rem] shrink-0 snap-center">
            <a
              href={instagramUrl}
              rel="noopener noreferrer"
              target="_blank"
              class="hero-surface group flex aspect-[9/16] flex-col justify-between rounded-2xl p-5 no-underline"
            >
              <InstagramIcon class="size-6 text-white/80" />
              <span>
                <span class="block font-display text-3xl leading-tight italic">{topic}</span>
                <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-white/80 group-hover:underline">
                  Ver en Instagram
                  <ArrowUpRight aria-hidden="true" className="size-4" />
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Texto para buscadores, como el bloque "Ver más" de la referencia -->
  <section aria-label="Sobre la clínica" class="container-page pb-16">
    <div
      class="seo-text mx-auto max-w-[53rem] rounded-[1.25rem] bg-[#e4e4e4] p-5 sm:p-6"
      data-open="false"
      data-seo
    >
      <div class="seo-body gap-8 md:columns-2" id="seo-texto">
        <h2>{clinic.name}: ortodoncia y estética dental en Bucaramanga</h2>
        <p>
          Nos dedicamos a la ortodoncia y la estética dental. Atendemos con cita previa, de lunes a
          sábado, en {clinic.address.street}, barrio {clinic.address.neighborhood}, en
          {clinic.address.city}.
        </p>
        <h3>Ortodoncia con brackets y alineadores</h3>
        <p>
          Trabajamos con brackets convencionales, brackets de autoligado, el sistema Flow Jac y
          alineadores transparentes AlineaPro, la marca propia de la clínica. En la valoración le
          explicamos qué opción conviene en su caso.
        </p>
        <h3>Diseño de sonrisa con planificación digital</h3>
        <p>
          El diseño de sonrisa digital, el microdiseño y los lentes cerámicos o de cerómero impresos
          en 3D se planifican en la computadora antes de empezar y se fabrican en nuestro
          laboratorio.
        </p>
        <h3>Odontología especializada</h3>
        <p>
          También atendemos odontología general y especializada, como endodoncia e implantes, para
          cuidar la salud de toda la boca.
        </p>
      </div>
      <div class="mt-3 border-t border-ink/15 pt-2 text-center">
        <button
          type="button"
          class="inline-flex min-h-tap items-center gap-1 text-sm font-semibold"
          aria-expanded="false"
          aria-controls="seo-texto"
          data-seo-toggle
        >
          <span data-seo-label>Ver más</span>
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="size-4 transition-transform"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            data-seo-chevron
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const box = document.querySelector<HTMLElement>("[data-seo]");
  const toggle = box?.querySelector<HTMLButtonElement>("[data-seo-toggle]");
  toggle?.addEventListener("click", () => {
    const open = box!.dataset.open !== "true";
    box!.dataset.open = String(open);
    toggle.setAttribute("aria-expanded", String(open));
    box!.querySelector("[data-seo-label]")!.textContent = open ? "Ver menos" : "Ver más";
    box!.querySelector("[data-seo-chevron]")?.classList.toggle("rotate-180", open);
  });
</script>
